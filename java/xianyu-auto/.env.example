# ============================================================================
# 闲鱼自动发货系统 - 环境变量配置清单
# 使用方法：
#   1. 复制本文件为 .env: cp .env.example .env
#   2. 按需填写下面的配置项
#   3. 启动: docker compose up -d --build
# ============================================================================

# ----------------------------------------------------------------------------
# 【必填】不填写无法启动核心功能
# ----------------------------------------------------------------------------

# 服务端口（容器内固定 12400，此处仅用于宿主机映射）
SERVER_PORT=12400

# 旧 SQLite（迁移用）
SQLITE_PATH=./data/xianyu.db

# MySQL 主库（ERP）— project_agent 统一用 twlmac:3306
MYSQL_HOST=twlmac
MYSQL_PORT=3306
MYSQL_DB=xx_erp
MYSQL_USER=root
# 密码若含 #，请用 \u0023 代替；twlmac 默认 root123456
MYSQL_PASSWORD=root123456

# AES-256 加密密钥（32 字节字符串，用于加密闲鱼 Cookie 和卡密）
# ⚠️ 生产环境必须修改！建议使用 openssl rand -base64 32 生成
ENCRYPT_KEY=xianyu-auto-default-encrypt-key-change

# Sa-Token JWT 签名密钥（≥ 32 字符）
# ⚠️ 生产环境必须修改！建议使用 openssl rand -base64 48 生成
SA_TOKEN_JWT_SECRET=xianyu-auto-default-jwt-secret-key-change-me-please-32chars

# 首次启动 admin 用户密码（首次启动后可登录后台修改）
DEFAULT_ADMIN_PASSWORD=admin123

# 日志级别（DEBUG / INFO / WARN / ERROR）
LOG_LEVEL=INFO

# 日志文件存放目录（本地 ./logs；Docker 容器内 /app/logs）
LOG_PATH=./logs


# ----------------------------------------------------------------------------
# 【选填】AI 智能回复 - 至少填写一个 API Key 才能启用 AI 回复
# ----------------------------------------------------------------------------

# 默认 AI 提供商: openai / dashscope / deepseek
AI_DEFAULT_PROVIDER=dashscope

# 请求超时（毫秒）
AI_TIMEOUT_MS=30000
# 失败重试次数
AI_RETRY_COUNT=2
# 上下文保留消息数
AI_CONTEXT_WINDOW=20

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- 阿里云 DashScope（通义千问，推荐，国内速度快） ----
# 申请地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus

# ---- DeepSeek ----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat


# ----------------------------------------------------------------------------
# 【选填】通知渠道 - 按需启用
# ----------------------------------------------------------------------------

# 邮件通知
NOTIFY_EMAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
# 发件人邮箱地址（如留空则使用 MAIL_USERNAME）
MAIL_FROM=

# 企业微信群机器人 Webhook
# 格式：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
WECOM_WEBHOOK_URL=

# iOS Bark 推送（https://bark.day.app/）
BARK_KEY=


# ----------------------------------------------------------------------------
# 【选填】闲鱼集成高级配置 - 一般无需修改
# ----------------------------------------------------------------------------

# MTOP 协议固定值
XIANYU_APP_KEY=34839810

# Cookie 保活间隔（分钟）
XIANYU_COOKIE_KEEPALIVE_MIN=30

# _m_h5_tk 刷新间隔（小时，随机区间）
XIANYU_MH5TK_REFRESH_MIN_HOURS=1.5
XIANYU_MH5TK_REFRESH_MAX_HOURS=2.5

# WebSocket Token 刷新间隔（小时，随机区间）
XIANYU_WS_TOKEN_REFRESH_MIN_HOURS=10
XIANYU_WS_TOKEN_REFRESH_MAX_HOURS=14

# WebSocket 心跳间隔与超时（秒）
XIANYU_HEARTBEAT_INTERVAL_SEC=15
XIANYU_HEARTBEAT_TIMEOUT_SEC=5

# 自动回复随机延时（秒，避免机器人检测）
REPLY_DELAY_MIN_SEC=3
REPLY_DELAY_MAX_SEC=7


# ----------------------------------------------------------------------------
# 【选填】浏览器自动化（扫码登录，Phase 7 选配）
# ----------------------------------------------------------------------------

PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_CHROMIUM_PATH=
