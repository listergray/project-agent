# 抖音目录发视频
SERVER_PORT=12500

# 视频目录 （绝对路径）
VIDEO_DIR=

# Playwright headless: false = show browser for QR login
HEADLESS=false

# Chromium persistent profile (login state)
BROWSER_PROFILE_DIR=./data/browser-profile

# Job / runtime data
DATA_DIR=./data

# Upload wait timeout (ms)
UPLOAD_TIMEOUT_MS=300000

# Publish geo tag (always applied)
DEFAULT_LOCATION=北京市朝阳区

# Hashtags appended to 作品简介 (comma-separated)
PUBLISH_HASHTAGS=#ai编程,#干货

# Test phase: allow these EPs to republish even if SUCCESS (comma-separated; empty = none)
ALLOW_REPUBLISH_EPS=32

# DeepSeek text judge for title/cover/topics (deepseek-chat 无视觉，只看 DOM 事实)
LLM_ENABLED=true
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# Only list EP.N videos with N >= MIN_EP (also stored in MySQL dy_meta)
MIN_EP=32

# MySQL (twlmac) — dy_episode / dy_meta
MYSQL_HOST=twlmac
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123456
MYSQL_DB=douyin_auto

# Login keepalive: open creator center periodically to refresh cookies
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL_MIN=45
# Random ± minutes (and 0-90s) so cadence is not fixed
KEEP_ALIVE_JITTER_MIN=12
