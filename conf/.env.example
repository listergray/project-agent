# ========== 服务基础 ==========
PORT=8080
LOG_LEVEL=INFO
ENV=dev

# ========== 局域网基础设施 Host（Docker 宿主机）==========
# 改 IP 只改这一行；下方 MILVUS/MYSQL/REDIS/MINIO 留空则自动用此 Host
INFRA_HOST=192.168.1.46

# ========== LLM (简历面试时最常用：DeepSeek + 硅基流动/阿里百炼 兼容OpenAI协议) ==========
# 主LLM：问答 / SQL / 意图识别 / 代码生成
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60

# 立项文档图片理解（DeepSeek 文本模型不支持图；建议配硅基流动/百炼等多模态）
# 例：LLM_VISION_BASE_URL=https://api.siliconflow.cn/v1
#     LLM_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
#     LLM_VISION_API_KEY=sk-xxx
LLM_VISION_MODEL=
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=

# ========== 向量模型 ==========
# 优先本地模型（无GPU自动降级CPU），不需要key
EMBED_MODEL_NAME=BAAI/bge-small-zh-v1.5        # 快速入门版，1024维≈效果够用。进阶可换 BAA-M3
EMBED_MODEL_CACHE_DIR=./data/models
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3

# ========== Milvus 向量库（RAG 知识库 · 主路径依赖）==========
# 留空 = 使用 INFRA_HOST
MILVUS_HOST=
MILVUS_PORT=19530
MILVUS_ALIAS=default

# ========== MinIO 对象存储（可选：PDF/MD/图片；当前演示可本地路径导入） ==========
# 留空 = INFRA_HOST:9000
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_KB=kb-files

# ========== MySQL（规划/可选 · 当前主路径未强依赖） ==========
# 留空 = INFRA_HOST
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123456
MYSQL_DB_META=project_agent_meta
MYSQL_DB_DW=project_agent_dw

# ========== Redis（规划/可选 · 当前主路径未强依赖） ==========
# 留空 = INFRA_HOST
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========== Self-RAG（入口路由是否检索 + 检索后 Grade 再检索）==========
SELF_RAG_MAX_RETRIES=1
ENABLE_SELF_RAG_ROUTE=true

# ========== RAG 工程化开关 ==========
# 完整架构演示：下列全开。现场直播嫌慢可改用 conf/.env.demo
ENABLE_MULTI_QUERY=true
MULTI_QUERY_COUNT=3
ENABLE_FAITHFULNESS=true
ENABLE_GRAPH_HITL=true
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite

# ========== 会话记忆 / 消息窗口裁剪 ==========
CHAT_MAX_HISTORY_TURNS=12
CHAT_MAX_HISTORY_MESSAGES=16
CHAT_MAX_HISTORY_CHARS=6000

# ========== 项目库业务后端（NestJS / 芋道 Java）==========
# Nest stub 跑在本机应用侧：java/_nest-biz-stub/packages/server → 通常 http://127.0.0.1:48080
# （与 Docker 中间件 INFRA_HOST 分开；勿把 stub 误配到不可达的局域网 IP）
# 空 = Python 本地 JSON 演示回退
PROJECT_BIZ_BASE_URL=http://127.0.0.1:48080
PROJECT_BIZ_TIMEOUT=15

# ========== LangSmith 链路追踪（可选）==========
# 开启后需配置 API Key；本地开发可保持 false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=project-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
