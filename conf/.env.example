# ========== 服务基础 ==========
PORT=8080
LOG_LEVEL=INFO
ENV=dev

# ========== LLM (简历面试时最常用：DeepSeek + 硅基流动/阿里百炼 兼容OpenAI协议) ==========
# 主LLM：问答 / SQL / 意图识别 / 代码生成
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60

# ========== 向量模型 ==========
# 优先本地模型（无GPU自动降级CPU），不需要key
EMBED_MODEL_NAME=BAAI/bge-small-zh-v1.5        # 快速入门版，1024维≈效果够用。进阶可换 BAA-M3
EMBED_MODEL_CACHE_DIR=./data/models
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3

# ========== Milvus 向量库（RAG 知识库）==========
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_ALIAS=default

# ========== MinIO 对象存储（PDF/MD/图片） ==========
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_KB=kb-files

# ========== MySQL（任务记录 / 对话历史 / DW数仓） ==========
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123456
MYSQL_DB_META=project_agent_meta
MYSQL_DB_DW=project_agent_dw

# ========== Redis 缓存 ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========== Self-RAG（检索质量评估 + 改写再检索）==========
SELF_RAG_MAX_RETRIES=1

# ========== RAG 工程化开关 ==========
ENABLE_MULTI_QUERY=true
MULTI_QUERY_COUNT=3
ENABLE_FAITHFULNESS=true
ENABLE_GRAPH_HITL=true
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite

# ========== 会话记忆 / 消息窗口裁剪 ==========
CHAT_MAX_HISTORY_TURNS=12
CHAT_MAX_HISTORY_MESSAGES=16
CHAT_MAX_HISTORY_CHARS=6000

# ========== 项目库 Java 业务（芋道单体/微服务）==========
# 空 = Python 本地 JSON 演示；填芋道地址后 CRUD/审批转发 Java
# AI 解析与审批后 RAG 同步始终在本仓 Python
PROJECT_BIZ_BASE_URL=
PROJECT_BIZ_TIMEOUT=15

# ========== LangSmith 链路追踪（可选）==========
# 开启后需配置 API Key；本地开发可保持 false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=project-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
