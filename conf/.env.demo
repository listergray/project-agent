# 现场演示精简配置（少 LLM hops，降低超时）
# 用法：复制到 conf/.env 覆盖对应项，或：
#   copy conf\.env.demo conf\.env   （再补回你的 LLM_API_KEY）
#
# 完整架构 walkthrough 请用 .env.example 默认「全开」组合。

ENV=demo

# 局域网容器宿主机（改 IP 只改这里）
INFRA_HOST=192.168.1.46

# 仍保留入口 Self-RAG 路由（演示「跳过/走 RAG」徽章）
ENABLE_SELF_RAG_ROUTE=true
SELF_RAG_MAX_RETRIES=1

# 少开：多查询 2 条；关忠实度（少一次 LLM）；HITL 可按需关
ENABLE_MULTI_QUERY=true
MULTI_QUERY_COUNT=2
ENABLE_FAITHFULNESS=false
ENABLE_GRAPH_HITL=true

PROJECT_BIZ_BASE_URL=http://127.0.0.1:48080
PROJECT_BIZ_TIMEOUT=15
